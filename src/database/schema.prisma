generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Tier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String    @unique
  password  String
  tier      Tier      @default(FREE)
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accessTokens AccessToken[]
  documents    Document[]
  usageLogs   UsageLog[]
  conversations Conversation[]
  @@index([email], name: "idx_user_email")
  @@map("users")
}

model AccessToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("access_tokens")
}

// Document model for storing file metadata
enum DocumentKind {
  PDF
  TEXT
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EMBEDDING
  READY
  FAILED
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  originalName    String
  kind            DocumentKind
  mimeType        String
  sizeBytes       Int
  checksum        String
  storageProvider String
  storageKey      String
  status          DocumentStatus @default(UPLOADED)
  failureReason   String?
  pageCount       Int?
  chunkCount      Int            @default(0)
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@unique([userId, checksum])
  @@index([userId, status])
  @@map("documents")
}

model DocumentChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  documentId     String                      @db.Uuid
  userId         String                      @db.Uuid
  chunkIndex     Int
  content        String
  characterCount Int
  pageNumber     Int?
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingProvider String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  deletedAt      DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId])
  @@map("document_chunks")
}

enum UsageKind {
  EMBEDDING
  CHAT_COMPLETION
}

model UsageLog {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  kind             UsageKind
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int       @default(0)
  totalTokens      Int
  costUsd          Decimal   @db.Decimal(12, 6)
  documentId       String?   @db.Uuid
  conversationId   String?   @db.Uuid
  correlationId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("usage_logs")
}

// Chat 
enum MessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  documentIds String[]  @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id               String      @id @default(uuid()) @db.Uuid
  conversationId   String      @db.Uuid
  role             MessageRole
  content          String
  citations        Json?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}