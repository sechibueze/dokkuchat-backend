generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleType {
  USER
  ADMIN
}

enum Tier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String    @unique
  password  String
  tier      Tier      @default(FREE)
  legacyRole      RoleType      @default(USER)
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accessTokens AccessToken[]
  documents    Document[]
  usageLogs   UsageLog[]
  conversations Conversation[]
  toolApprovals ToolApproval[]

  @@index([roleId])
  @@index([email], name: "idx_user_email")
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isDefault    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       User[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles RolePermission[]
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @db.Uuid
  permissionId String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AccessToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("access_tokens")
}

// Document model for storing file metadata
enum DocumentKind {
  PDF
  TEXT
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EMBEDDING
  READY
  FAILED
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  originalName    String
  kind            DocumentKind
  mimeType        String
  sizeBytes       Int
  checksum        String
  storageProvider String
  storageKey      String
  status          DocumentStatus @default(UPLOADED)
  failureReason   String?
  pageCount       Int?
  chunkCount      Int            @default(0)
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@unique([userId, checksum])
  @@index([userId, status])
  @@map("documents")
}

model DocumentChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  documentId     String                      @db.Uuid
  userId         String                      @db.Uuid
  chunkIndex     Int
  content        String
  characterCount Int
  pageNumber     Int?
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingProvider String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  deletedAt      DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId])
  @@map("document_chunks")
}

enum UsageKind {
  EMBEDDING
  CHAT_COMPLETION
}

model UsageLog {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  kind             UsageKind
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int       @default(0)
  totalTokens      Int
  costUsd          Decimal   @db.Decimal(12, 6)
  documentId       String?   @db.Uuid
  conversationId   String?   @db.Uuid
  correlationId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("usage_logs")
}

// Chat 
enum MessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  documentIds String[]  @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id               String      @id @default(uuid()) @db.Uuid
  conversationId   String      @db.Uuid
  role             MessageRole
  content          String
  citations        Json?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  status        MessageStatus  @default(COMPLETED)
  agentState    Json?
  toolApprovals ToolApproval[]
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}


enum MessageStatus {
  COMPLETED
  AWAITING_APPROVAL
}

enum ToolApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ToolApproval {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  conversationId String             @db.Uuid
  messageId      String             @db.Uuid
  toolCallId     String
  serverName     String
  toolName       String
  arguments      Json
  status         ToolApprovalStatus @default(PENDING)
  autoApproved   Boolean            @default(false)
  decidedAt      DateTime?
  result         String?
  error          String?
  expiresAt      DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([messageId])
  @@index([status, expiresAt])
  @@map("tool_approvals")
}